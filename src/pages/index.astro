---
import MainLayout from "../components/MainLayout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero";
import Pillars from "../components/Pillars.astro";
import Footer from "../components/Footer.astro";
import "../styles/hero.css";
---

<MainLayout
	title="Ember Motion Studio | Motion Design & Animation Software for OBS, Twitch and Broadcast"
	description="Create broadcast overlays, lower thirds and motion graphics in real time with Ember Motion Studio. Free animation software for OBS, Twitch and DaVinci Resolve. Open Source MIT."
	lang="en"
>
	<Navigation />

	<main>
		<Hero client:load lang="en" />


		<Pillars />

		<!-- Photographer Case Study Section -->
		<section class="case-study">
			<div class="case-study-inner">
				<p class="case-study-label">Real-World Case Study</p>
				<h2 class="case-study-title">Watch Ember Motion Studio in Action</h2>
				
				<div class="case-study-card">
					<div class="case-study-image-wrapper">
						<iframe 
							class="case-study-video"
							src="https://www.youtube.com/embed/tjsKyZXpngQ" 
							title="Ember Motion Studio Promo Video" 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
					<div class="case-study-content">
						<div class="quote-icon">“</div>
						<p class="case-study-quote">
							I created the official Ember promotional video myself using the app. I described the animation vibe to the AI, pasted the generated code into Ember, and exported the ProRes 4444 file with an alpha channel. Then, I simply dragged the video into DaVinci Resolve to add sound design and export the final piece in minutes.
						</p>
						<div class="case-study-author">
							<div class="author-details">
								<strong>Jonatan Barón</strong>
								<span>Creator of Ember Motion Studio</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Use cases — semantic vocabulary for broadcast & streaming search -->
		<section class="use-cases">
			<div class="use-cases-inner">
				<p class="use-cases-label">Who it's for</p>
				<h2 class="use-cases-title">
					Motion Design Software<br />for Streamers & Broadcast Producers
				</h2>
				<p class="use-cases-desc">
					Ember Motion Studio is the professional motion design and animation software
					powered by the DVGE engine — built for video editors, broadcast producers
					and developers who need animated vector graphics ready for DaVinci Resolve,
					Premiere Pro, After Effects, OBS and Twitch.
				</p>
				<div class="use-cases-grid">
					<div class="use-case-item">
						<div class="use-case-preview">
							<video muted loop playsinline preload="metadata" class="lazy-video use-case-video">
								<source src={`${import.meta.env.BASE_URL}multimedia/demo2.mp4`} type="video/mp4" />
							</video>
						</div>
						<span class="use-case-tag">Lower Thirds</span>
						<p>
							Animated text bands for interviews, news and documentaries.
							Direct export as .mov with alpha channel. Supports stinger
							transitions and transparent backgrounds.
						</p>
					</div>
					<div class="use-case-item">
						<div class="use-case-preview">
							<video muted loop playsinline preload="metadata" class="lazy-video use-case-video">
								<source src={`${import.meta.env.BASE_URL}multimedia/demo1.mp4`} type="video/mp4" />
							</video>
						</div>
						<span class="use-case-tag">Broadcast Overlays</span>
						<p>
							Markers, clocks, weather widgets and scoreboards for live
							streams. Browser source compatible with OBS and vMix —
							CPU-friendly and WebM ready.
						</p>
					</div>
					<div class="use-case-item">
						<div class="use-case-preview">
							<video muted loop playsinline preload="metadata" class="lazy-video use-case-video">
								<source src={`${import.meta.env.BASE_URL}multimedia/demo5.mp4`} type="video/mp4" />
							</video>
						</div>
						<span class="use-case-tag">Animated Titles</span>
						<p>
							Cinematic openings and section titles with frame-perfect
							vector animations reproducible on any hardware. Full
							motion graphics control.
						</p>
					</div>
					<div class="use-case-item">
						<div class="use-case-preview">
							<video muted loop playsinline preload="metadata" class="lazy-video use-case-video">
								<source src={`${import.meta.env.BASE_URL}multimedia/demo3.mp4`} type="video/mp4" />
							</video>
						</div>
						<span class="use-case-tag">Automation</span>
						<p>
							Generate data-driven graphics in batch from external sources.
							Ideal for news and sports production with real-time rendering.
						</p>
					</div>
				</div>
			</div>
		</section>
    
    <!-- New Section: Production Examples -->
    <section class="home-examples" id="creative-workflow-showcase">
      <div class="examples-inner">
        <div class="examples-header">
          <p class="section-label">Portafolio</p>
          <h2 class="section-title">Animation Software in Action: Overlays, Lower Thirds & Motion Graphics</h2>
          <p class="section-subtitle">Choose a professional template, load it in Ember, customize parameters, and export instantly.</p>
        </div>

        <div class="examples-grid">
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Template Horizons Preview" title="Template Horizons Broadcast Overlay" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo1.mp4`} type="video/mp4" />
              </video>
            </div>
            <div class="example-info">
              <span class="template-tag">Broadcast & News</span>
              <h4>Template Horizons</h4>
              <p class="template-action">Load template in Ember & Customize →</p>
            </div>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Social Minimal Preview" title="Social Minimal Streaming Graphics" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo2.mp4`} type="video/mp4" />
              </video>
            </div>
            <div class="example-info">
              <span class="template-tag">Streamers & Marketers</span>
              <h4>Social Minimal</h4>
              <p class="template-action">Load template in Ember & Customize →</p>
            </div>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Dynamic Motion Graphics Preview" title="Dynamic Motion Graphics Example" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo3.mp4`} type="video/mp4" />
              </video>
            </div>
            <div class="example-info">
              <span class="template-tag">Data Analysts & Sports</span>
              <h4>Dynamic Motion Graphics</h4>
              <p class="template-action">Load template in Ember & Customize →</p>
            </div>
          </div>
        </div>

        <div class="examples-cta">
          <a href={`${import.meta.env.BASE_URL}examples/`} class="btn-more-examples">
            View more templates & examples →
          </a>
        </div>
      </div>
    </section>

    <!-- Showcase Section -->
    <!-- Showcase Section -->
		<!--
		<section class="home-showcase">
			<div class="showcase-inner">
				<div class="showcase-header">
					<p class="section-label">Showcase</p>
					<h2 class="section-title">Success Stories</h2>
					<a
						href={`${import.meta.env.BASE_URL}showcase/`}
						class="section-link">View all showcase →</a
					>
				</div>
				<div class="showcase-preview">
					<div class="preview-card">
						<div class="preview-img">
							<img
								src={`${import.meta.env.BASE_URL}logo-square.png`}
								alt="Broadcast"
								width="50"
							/>
						</div>
						<h4>Sports Broadcast</h4>
						<p class="preview-desc">Real-time scoreboards for regional leagues.</p>
						<div class="preview-comment">
							"Ember professionalized our streams."
						</div>
						<a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-" target="_blank" class="preview-link">View Project →</a>
					</div>
					<div class="preview-card">
						<div class="preview-img">
							<img
								src={`${import.meta.env.BASE_URL}logo-square.png`}
								alt="Corporativo"
								width="50"
							/>
						</div>
						<h4>Corporate Streaming</h4>
						<p class="preview-desc">Minimalist overlays for hybrid events.</p>
						<div class="preview-comment">
							"We saved hours of manual rendering."
						</div>
						<a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-" target="_blank" class="preview-link">View Project →</a>
					</div>
				</div>
			</div>
		</section>
		-->

		<section class="project-status">
			<div class="status-inner">
				<div class="status-left">
					<p class="status-label">Project Status</p>
					<h3 class="status-title">
						MIT License.<br />Actively developed.
					</h3>
					<p class="status-desc">
						Ember Motion Studio is an <strong>MIT Licensed</strong> platform powered by the DVGE engine. The current v5 release is fully open-source and free, ensuring core technical stability and seamless standard workflows while laying the foundation for advanced commercial extensions in future milestones.
					</p>
					<a href={`${import.meta.env.BASE_URL}engine/roadmap/`} class="status-link"
						>View full roadmap →</a
					>
				</div>
				<div class="status-right">
					<ul class="roadmap-list">
						<li class="done">
							<span class="roadmap-version">v5.6.0</span>
							<span class="roadmap-desc"
								>Professional UI & Centralized Control</span
							>
						</li>
						<li class="done">
							<span class="roadmap-version">v5.7.0</span>
							<span class="roadmap-desc">Transparent Loading</span>
						</li>
						<li class="done">
							<span class="roadmap-version">v5.8.0</span>
							<span class="roadmap-desc"
								>Optimized Startup & Inspector/Artifacts Panel</span
							>
						</li>
						<li class="done">
							<span class="roadmap-version">v5.9.0</span>
							<span class="roadmap-desc"
								>Performance Improvements</span
							>
						</li>
						<li>
							<span class="roadmap-version">v6.0.0</span>
							<span class="roadmap-desc"
								>Batch Rendering & New Hierarchical Extension System</span
							>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Stories Section (Testimonials) 
		<section class="home-stories">
			<div class="stories-inner">
				<p class="section-label">Community</p>
				<h2 class="section-title">User Stories</h2>
				<div class="story-preview-grid">
					<div class="story-bubble">
						<p>
							"Ember changed the way I deliver my projects.
							I no longer wait for heavy renders."
						</p>
						<span class="story-author">— Alejandro M.</span>
					</div>
					<div class="story-bubble">
						<p>
							"The precision of the alpha channel in the DVGE engine is
							impeccable."
						</p>
						<span class="story-author">— Sofía R.</span>
					</div>
				</div>
				<div style="text-align: center; margin-top: 3rem;">
					<a
						href={`${import.meta.env.BASE_URL}stories/`}
						class="btn-stories">Read more stories →</a
					>
				</div>
			</div>
		</section>
		Stories Section (Testimonials) -->
	</main>

	<Footer />
  
  <script>
    // Optimización de videos: solo reproducir cuando son visibles
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {}); // Ignorar errores de autoplay
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.lazy-video').forEach(video => {
      observer.observe(video);
    });
  </script>

</MainLayout>

<style>
	main {
		width: 100%;
	}

	/* ── Casos de uso ── */
	.use-cases {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	@media (min-width: 768px) {
		.use-cases {
			padding: 2rem 4rem 6rem;
		}
	}

	.use-cases-inner {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding-top: 4rem;
	}

	.use-cases-label {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.65rem;
		font-weight: 500;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 1rem 0;
	}

	.use-cases-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0 0 1.25rem 0;
	}

	.use-cases-desc {
		font-size: 0.9rem;
		color: #555;
		line-height: 1.7;
		max-width: 600px;
		margin: 0 0 3rem 0;
	}

	.use-cases-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		overflow: hidden;
	}

	@media (max-width: 600px) {
		.use-cases-grid {
			grid-template-columns: 1fr;
		}
	}

	.use-case-item {
		background: #050505;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.use-case-item:hover {
		background: rgba(255, 255, 255, 0.02);
	}

	.use-case-preview {
		width: 100%;
		aspect-ratio: 16/9;
		background: #000;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.06);
		margin-bottom: 0.5rem;
		position: relative;
	}

	.use-case-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.8;
		transition: opacity 0.3s ease;
	}

	.use-case-item:hover .use-case-video {
		opacity: 1;
	}

	.use-case-tag {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.use-case-item p {
		font-size: 0.875rem;
		color: #555;
		line-height: 1.65;
		margin: 0;
	}

	/* ── Ejemplos (Home) ── */
	.home-examples {
		max-width: 1200px;
		margin: 0 auto;
		padding: 6rem 1.5rem;
	}
	.examples-header {
		text-align: center;
		margin-bottom: 4rem;
	}
	.section-label {
		font-family: "JetBrains Mono", monospace;
		color: #e44c30;
		text-transform: uppercase;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		margin-bottom: 1rem;
	}
	.section-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: #fff;
		margin-bottom: 1.5rem;
	}
	.section-subtitle {
		color: #666;
		font-size: 1.1rem;
		max-width: 600px;
