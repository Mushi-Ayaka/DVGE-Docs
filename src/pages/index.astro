---
import MainLayout from "../components/MainLayout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero";
import Pillars from "../components/Pillars.astro";
import Footer from "../components/Footer.astro";
import "../styles/hero.css";
---

<MainLayout
	title="Ember Motion Studio — Lower Thirds y Overlays Broadcast para Windows | ProRes 4444"
	description="DVGE es una aplicación de escritorio para Windows que genera overlays, lower thirds y gráficos broadcast animados con exportación ProRes 4444 + Alpha para DaVinci Resolve, Premiere Pro y After Effects. Open Source MIT."
>
	<Navigation />

	<main>
		<Hero client:load />
		<Pillars />

		<!-- Sección de casos de uso — vocabulario de editores de video -->
		<section class="use-cases">
			<div class="use-cases-inner">
				<p class="use-cases-label">Para quién es</p>
				<h2 class="use-cases-title">
					Un entorno de diseño.<br />Un motor de producción.
				</h2>
				<p class="use-cases-desc">
					Ember Motion Studio es un entorno de producción profesional
					impulsado por el motor DVGE, diseñado para editores de
					video, productores broadcast y desarrolladores que necesitan
					gráficos animados listos para arrastrar a DaVinci Resolve,
					Premiere Pro o After Effects.
				</p>
				<div class="use-cases-grid">
					<div class="use-case-item">
						<span class="use-case-tag">Lower Thirds</span>
						<p>
							Bandas de texto animadas para entrevistas, noticias
							y documentales. Exportación directa como .mov con
							canal alfa.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Overlays Broadcast</span>
						<p>
							Marcadores, relojes, widgets de clima y scoreboard
							para transmisiones en vivo. Compatible con OBS y
							vMix.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Títulos Animados</span>
						<p>
							Aperturas cinemáticas y títulos de sección con
							animaciones frame-perfect reproducibles en cualquier
							hardware.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Automatización</span>
						<p>
							Genera gráficos en lote desde datos externos. Ideal
							para producción de noticias y deportes con datos en
							tiempo real.
						</p>
					</div>
				</div>
			</div>
		</section>
    
    <!-- Nueva Sección: Ejemplos de Producción -->
    <section class="home-examples">
      <div class="examples-inner">
        <div class="examples-header">
          <p class="section-label">Showcase</p>
          <h2 class="section-title">Resultados de Nivel Broadcast</h2>
          <p class="section-subtitle">Visualiza la potencia del motor DVGE en acción a través de nuestras plantillas integradas.</p>
        </div>

        <div class="examples-grid">
          <div class="example-item">
            <div class="video-preview">
              <video autoplay muted loop playsinline poster={`${import.meta.env.BASE_URL}logo-square.png`}>
                <source src={`${import.meta.env.BASE_URL}multimedia/demo1.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Template Horizons</h4>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video autoplay muted loop playsinline poster={`${import.meta.env.BASE_URL}logo-square.png`}>
                <source src={`${import.meta.env.BASE_URL}multimedia/demo2.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Social Minimal</h4>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video autoplay muted loop playsinline poster={`${import.meta.env.BASE_URL}logo-square.png`}>
                <source src={`${import.meta.env.BASE_URL}multimedia/demo3.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Gráficos Dinámicos</h4>
          </div>
        </div>

        <div class="examples-cta">
          <a href={`${import.meta.env.BASE_URL}ejemplos/`} class="btn-more-examples">
            Ver más ejemplos y tutoriales →
          </a>
        </div>
      </div>
    </section>

		<!-- Sección de Evidencias (Showcase) -->
		<!-- Sección de Evidencias (Showcase) -->
		<!--
		<section class="home-showcase">
			<div class="showcase-inner">
				<div class="showcase-header">
					<p class="section-label">Evidencias</p>
					<h2 class="section-title">Casos de Éxito</h2>
					<a
						href={`${import.meta.env.BASE_URL}evidencias/`}
						class="section-link">Ver todas las evidencias →</a
					>
				</div>
				<div class="showcase-preview">
					<div class="preview-card">
						<div class="preview-img">
							<img
								src={`${import.meta.env.BASE_URL}logo-square.png`}
								alt="Broadcast"
								width="50"
							/>
						</div>
						<h4>Broadcast de Deportes</h4>
						<p class="preview-desc">Marcadores en tiempo real para ligas regionales.</p>
						<div class="preview-comment">
							"Ember profesionalizó nuestras transmisiones."
						</div>
						<a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-" target="_blank" class="preview-link">Ver Proyecto →</a>
					</div>
					<div class="preview-card">
						<div class="preview-img">
							<img
								src={`${import.meta.env.BASE_URL}logo-square.png`}
								alt="Corporativo"
								width="50"
							/>
						</div>
						<h4>Streaming Corporativo</h4>
						<p class="preview-desc">Overlays minimalistas para eventos híbridos.</p>
						<div class="preview-comment">
							"Ahorramos horas de renderizado manual."
						</div>
						<a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-" target="_blank" class="preview-link">Ver Proyecto →</a>
					</div>
				</div>
			</div>
		</section>
		-->

		<section class="project-status">
			<div class="status-inner">
				<div class="status-left">
					<p class="status-label">Estado del proyecto</p>
					<h3 class="status-title">
						Open Source.<br />En desarrollo activo.
					</h3>
					<p class="status-desc">
						Ember Motion Studio es una plataforma <strong
							>MIT</strong
						> impulsada por el motor DVGE. El foco actual está en la madurez
						técnica del núcleo y la estabilidad del ecosistema de plugins.
					</p>
					<a href="/DVGE-Docs/engine/roadmap/" class="status-link"
						>Ver hoja de ruta completa →</a
					>
				</div>
				<div class="status-right">
					<ul class="roadmap-list">
						<li class="done">
							<span class="roadmap-version">v5.6.0</span>
							<span class="roadmap-desc"
								>Interfaz Profesional & Control Centralizado</span
							>
						</li>
						<li class="done">
							<span class="roadmap-version">v5.7.0</span>
							<span class="roadmap-desc">Carga Transparente</span>
						</li>
						<li class="done">
							<span class="roadmap-version">v5.8.0</span>
							<span class="roadmap-desc"
								>Inicio Optimizado & Panel de
								Inspector/Artefactos</span
							>
						</li>
						<li>
							<span class="roadmap-version">v5.9.0</span>
							<span class="roadmap-desc"
								>Mejora de Rendimiento</span
							>
						</li>
						<li>
							<span class="roadmap-version">v6.0.0</span>
							<span class="roadmap-desc"
								>Renderizado Masivo & Nuevo Sistema jerarquico
								para extensión</span
							>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Sección de Historias (Testimonios) 
		<section class="home-stories">
			<div class="stories-inner">
				<p class="section-label">Comunidad</p>
				<h2 class="section-title">Historias de Usuarios</h2>
				<div class="story-preview-grid">
					<div class="story-bubble">
						<p>
							"Ember cambió la forma en que entrego mis proyectos.
							Ya no espero renders pesados."
						</p>
						<span class="story-author">— Alejandro M.</span>
					</div>
					<div class="story-bubble">
						<p>
							"La precisión del canal alfa en el motor DVGE es
							impecable."
						</p>
						<span class="story-author">— Sofía R.</span>
					</div>
				</div>
				<div style="text-align: center; margin-top: 3rem;">
					<a
						href={`${import.meta.env.BASE_URL}historias/`}
						class="btn-stories">Leer más historias →</a
					>
				</div>
			</div>
		</section>
		Sección de Historias (Testimonios) -->
	</main>

	<Footer />

	<!-- JSON-LD: SoftwareApplication -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Dynamic Vector Graphics Engine (DVGE)",
			"alternateName": "DVGE",
			"description": "Aplicación de escritorio para Windows que genera overlays, lower thirds y gráficos broadcast animados con exportación ProRes 4444 + Alpha para DaVinci Resolve, Premiere Pro y After Effects.",
			"applicationCategory": "MultimediaApplication",
			"applicationSubCategory": "Broadcast Graphics Software",
			"operatingSystem": "Windows 10, Windows 11",
			"softwareVersion": "5.8.0",
			"keywords": "lower thirds, overlays broadcast, gráficos broadcast, ProRes 4444, DaVinci Resolve graphics, broadcast animation, lower third software Windows",
			"releaseNotes": "/about/changelog/",
			"downloadUrl": "https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-/releases/download/v5.8.0/EmberMotionStudio-Setup-5.8.0.exe",
			"installUrl": "https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-/releases/download/v5.8.0/EmberMotionStudio-Setup-5.8.0.exe",
			"license": "https://opensource.org/licenses/MIT",
			"isAccessibleForFree": true,
			"author": {
				"@type": "Person",
				"name": "Jonatan Barón",
				"url": "https://github.com/Mushi-Ayaka"
			},
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"url": "https://mushi-ayaka.github.io/DVGE-Docs/",
			"featureList": [
				"Exportación ProRes 4444 con canal alfa",
				"Lower thirds animados",
				"Overlays broadcast",
				"Compatible con DaVinci Resolve, Premiere Pro, After Effects",
				"Sistema de plugins extensible",
				"Preview en tiempo real a 60fps",
				"Sin instalación de dependencias previas"
			]
		}
	</script>

	<!-- JSON-LD: WebSite -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "DVGE — Dynamic Vector Graphics Engine",
			"url": "https://mushi-ayaka.github.io/DVGE-Docs/",
			"description": "Documentación oficial y descarga del motor de gráficos broadcast DVGE.",
			"author": {
				"@type": "Person",
				"name": "Jonatan Barón"
			}
		}
	</script>
</MainLayout>

<style>
	main {
		width: 100%;
	}

	/* ── Casos de uso ── */
	.use-cases {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	@media (min-width: 768px) {
		.use-cases {
			padding: 2rem 4rem 6rem;
		}
	}

	.use-cases-inner {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding-top: 4rem;
	}

	.use-cases-label {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.65rem;
		font-weight: 500;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 1rem 0;
	}

	.use-cases-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0 0 1.25rem 0;
	}

	.use-cases-desc {
		font-size: 0.9rem;
		color: #555;
		line-height: 1.7;
		max-width: 600px;
		margin: 0 0 3rem 0;
	}

	.use-cases-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		overflow: hidden;
	}

	@media (max-width: 600px) {
		.use-cases-grid {
			grid-template-columns: 1fr;
		}
	}

	.use-case-item {
		background: #050505;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.use-case-item:hover {
		background: rgba(255, 255, 255, 0.02);
	}

	.use-case-tag {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.use-case-item p {
		font-size: 0.875rem;
		color: #555;
		line-height: 1.65;
		margin: 0;
	}

	/* ── Ejemplos (Home) ── */
	.home-examples {
		max-width: 1200px;
		margin: 0 auto;
		padding: 6rem 1.5rem;
	}
	.examples-header {
		text-align: center;
		margin-bottom: 4rem;
	}
	.section-label {
		font-family: "JetBrains Mono", monospace;
		color: #e44c30;
		text-transform: uppercase;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		margin-bottom: 1rem;
	}
	.section-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: #fff;
		margin-bottom: 1.5rem;
	}
	.section-subtitle {
		color: #666;
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.examples-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-bottom: 4rem;
	}
	@media (max-width: 900px) {
		.examples-grid {
			grid-template-columns: 1fr;
		}
	}

	.example-item {
		background: #080808;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.3s ease;
	}
	.example-item:hover {
		transform: translateY(-5px);
		border-color: rgba(228, 76, 48, 0.3);
	}
	.video-preview {
		width: 100%;
		aspect-ratio: 16/9;
		background: #000;
		overflow: hidden;
	}
	.video-preview video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.7;
		transition: opacity 0.3s ease;
	}
	.example-item:hover video {
		opacity: 1;
	}
	.example-item h4 {
		padding: 1.5rem;
		color: #fff;
		font-family: "Outfit", sans-serif;
		font-size: 1.1rem;
		text-align: center;
	}

	.examples-cta {
		text-align: center;
	}
	.btn-more-examples {
		display: inline-block;
		padding: 1rem 2rem;
		border: 1px solid #e44c30;
		color: #e44c30;
		text-decoration: none;
		border-radius: 4px;
		font-weight: 600;
		transition: all 0.3s ease;
	}
	.btn-more-examples:hover {
		background: #e44c30;
		color: #fff;
		box-shadow: 0 5px 20px rgba(228, 76, 48, 0.3);
	}

	/* ── Showcase (Home) ── */
	.home-showcase {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
	@media (min-width: 768px) {
		.home-showcase {
			padding: 6rem 4rem;
		}
	}

	.showcase-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 3rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		padding-bottom: 2rem;
	}
	.section-label {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.65rem;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin-bottom: 0.5rem;
	}
	.section-title {
		font-family: "Outfit", sans-serif;
		font-size: 2rem;
		color: #fff;
		margin: 0;
	}
	.section-link {
		font-size: 0.85rem;
		color: #e44c30;
		text-decoration: none;
		font-weight: 600;
	}

	.showcase-preview {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}
	.preview-card {
		background: #0d0d0d;
		padding: 2rem;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: transform 0.3s ease;
	}
	.preview-card:hover {
		transform: translateY(-5px);
		border-color: rgba(228, 76, 48, 0.2);
	}
	.preview-img {
		margin-bottom: 1.5rem;
		opacity: 0.6;
	}
	.preview-card h4 { color: #fff; font-family: "Outfit", sans-serif; margin-bottom: 0.75rem; font-size: 1.1rem; }
	.preview-desc { color: #666; font-size: 0.85rem; line-height: 1.5; margin-bottom: 1.25rem; }
	.preview-comment { 
		font-style: italic; 
		color: #999; 
		font-size: 0.8rem; 
		border-left: 2px solid #e44c30; 
		padding-left: 0.75rem; 
		margin-bottom: 1.5rem;
		line-height: 1.4;
	}
	.preview-link {
		font-size: 0.75rem;
		color: #e44c30;
		text-decoration: none;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.preview-link:hover { text-decoration: underline; }

	/* ── Historias (Home) ── */
	.home-stories {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1.5rem 8rem;
	}
	@media (min-width: 768px) {
		.home-stories {
			padding: 6rem 4rem 10rem;
		}
	}

	.story-preview-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 3rem;
	}
	@media (max-width: 768px) {
		.story-preview-grid {
			grid-template-columns: 1fr;
		}
	}

	.story-bubble {
		background: rgba(228, 76, 48, 0.03);
		border-left: 3px solid #e44c30;
		padding: 2rem;
		border-radius: 0 16px 16px 0;
	}
	.story-bubble p {
		color: #ccc;
		font-style: italic;
		font-size: 1rem;
		margin-bottom: 1rem;
	}
	.story-author {
		color: #e44c30;
		font-weight: 700;
		font-size: 0.8rem;
	}

	.btn-stories {
		display: inline-block;
		padding: 0.8rem 2rem;
		border: 1px solid rgba(228, 76, 48, 0.3);
		color: #fff;
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		transition: all 0.2s ease;
	}
	.btn-stories:hover {
		background: rgba(228, 76, 48, 0.1);
		border-color: #e44c30;
	}

	/* ── Sección de Estado ── */
	.project-status {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 6rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	@media (min-width: 768px) {
		.project-status {
			padding: 4rem 4rem 8rem;
		}
	}

	.status-inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	@media (min-width: 768px) {
		.status-inner {
			grid-template-columns: 1fr 1fr;
			gap: 6rem;
			align-items: start;
		}
	}

	.status-label {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.65rem;
		font-weight: 500;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 1rem 0;
	}

	.status-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0 0 1.25rem 0;
	}

	.status-desc {
		font-size: 0.9rem;
		color: #666;
		line-height: 1.7;
		margin: 0 0 1.5rem 0;
	}

	.status-desc strong {
		color: #999;
		font-weight: 600;
	}

	.status-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: #e44c30;
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: opacity 0.2s;
	}
	.status-link:hover {
		opacity: 0.7;
	}

	/* Roadmap list — estilo tabla técnica */
	.roadmap-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.roadmap-list li {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 1rem;
		align-items: baseline;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		font-size: 0.85rem;
