		padding: 1rem 2rem;
		border: 1px solid #e44c30;
		color: #e44c30;
		text-decoration: none;
		border-radius: 4px;
		font-weight: 600;
		transition: all 0.3s ease;
	}
	.btn-more-examples:hover {
		background: #e44c30;
		color: #fff;
		box-shadow: 0 5px 20px rgba(228, 76, 48, 0.3);
