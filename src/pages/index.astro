	<Footer />
  
  <script>
    // Optimización de videos: solo reproducir cuando son visibles
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {}); // Ignorar errores de autoplay
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.lazy-video').forEach(video => {
      observer.observe(video);
    });
  </script>

</MainLayout>

<style>
	main {
		width: 100%;
	}

	/* ── Casos de uso ── */
	.use-cases {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	@media (min-width: 768px) {
		.use-cases {
			padding: 2rem 4rem 6rem;
		}
	}

	.use-cases-inner {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding-top: 4rem;
	}

	.use-cases-label {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.65rem;
		font-weight: 500;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 1rem 0;
	}

	.use-cases-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0 0 1.25rem 0;
	}

	.use-cases-desc {
		font-size: 0.9rem;
		color: #555;
		line-height: 1.7;
		max-width: 600px;
		margin: 0 0 3rem 0;
	}

	.use-cases-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		overflow: hidden;
	}

	@media (max-width: 600px) {
		.use-cases-grid {
			grid-template-columns: 1fr;
		}
	}

	.use-case-item {
		background: #050505;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.use-case-item:hover {
		background: rgba(255, 255, 255, 0.02);
	}

	.use-case-tag {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: #e44c30;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.use-case-item p {
		font-size: 0.875rem;
		color: #555;
		line-height: 1.65;
		margin: 0;
	}

	/* ── Ejemplos (Home) ── */
	.home-examples {
		max-width: 1200px;
		margin: 0 auto;
		padding: 6rem 1.5rem;
	}
	.examples-header {
		text-align: center;
		margin-bottom: 4rem;
	}
	.section-label {
		font-family: "JetBrains Mono", monospace;
		color: #e44c30;
		text-transform: uppercase;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		margin-bottom: 1rem;
	}
	.section-title {
		font-family: "Outfit", sans-serif;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		color: #fff;
		margin-bottom: 1.5rem;
	}
	.section-subtitle {
		color: #666;
		font-size: 1.1rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.examples-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-bottom: 4rem;
	}
	@media (max-width: 900px) {
		.examples-grid {
			grid-template-columns: 1fr;
		}
	}

	.example-item {
		background: #080808;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.05);
		transition: all 0.3s ease;
	}
	.example-item:hover {
		transform: translateY(-5px);
		border-color: rgba(228, 76, 48, 0.3);
	}
	.video-preview {
		width: 100%;
		aspect-ratio: 16/9;
		background: #000;
		overflow: hidden;
	}
	.video-preview video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.7;
		transition: opacity 0.3s ease;
	}
	.example-item:hover video {
		opacity: 1;
	}
	.example-item h4 {
		padding: 1.5rem;
		color: #fff;
		font-family: "Outfit", sans-serif;
		font-size: 1.1rem;
		text-align: center;
	}

