---
import MainLayout from "../components/MainLayout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero";
import Pillars from "../components/Pillars.astro";
import Footer from "../components/Footer.astro";
import "../styles/hero.css";
---

<MainLayout
	title="Ember Motion Studio | Motion Design & Animation Software for OBS, Twitch and Broadcast"
	description="Create broadcast overlays, lower thirds and motion graphics in real time with Ember Motion Studio. Free animation software for OBS, Twitch and DaVinci Resolve. Open Source MIT."
	lang="en"
>
	<Navigation />

	<main>
		<Hero client:load lang="en" />
		<Pillars />

		<!-- Use cases — semantic vocabulary for broadcast & streaming search -->
		<section class="use-cases">
			<div class="use-cases-inner">
				<p class="use-cases-label">Who it's for</p>
				<h2 class="use-cases-title">
					Motion Design Software<br />for Streamers & Broadcast Producers
				</h2>
				<p class="use-cases-desc">
					Ember Motion Studio is the professional motion design and animation software
					powered by the DVGE engine — built for video editors, broadcast producers
					and developers who need animated vector graphics ready for DaVinci Resolve,
					Premiere Pro, After Effects, OBS and Twitch.
				</p>
				<div class="use-cases-grid">
					<div class="use-case-item">
						<span class="use-case-tag">Lower Thirds</span>
						<p>
							Animated text bands for interviews, news and documentaries.
							Direct export as .mov with alpha channel. Supports stinger
							transitions and transparent backgrounds.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Broadcast Overlays</span>
						<p>
							Markers, clocks, weather widgets and scoreboards for live
							streams. Browser source compatible with OBS and vMix —
							CPU-friendly and WebM ready.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Animated Titles</span>
						<p>
							Cinematic openings and section titles with frame-perfect
							vector animations reproducible on any hardware. Full
							motion graphics control.
						</p>
					</div>
					<div class="use-case-item">
						<span class="use-case-tag">Automation</span>
						<p>
							Generate data-driven graphics in batch from external sources.
							Ideal for news and sports production with real-time rendering.
						</p>
					</div>
				</div>
			</div>
		</section>
    
    <!-- New Section: Production Examples -->
    <section class="home-examples">
      <div class="examples-inner">
        <div class="examples-header">
          <p class="section-label">Showcase</p>
          <h2 class="section-title">Animation Software in Action: Overlays, Lower Thirds & Motion Graphics</h2>
          <p class="section-subtitle">See the DVGE engine power in action through our built-in broadcast and streaming templates.</p>
        </div>

        <div class="examples-grid">
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Template Horizons Preview" title="Template Horizons Broadcast Overlay" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo1.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Template Horizons</h4>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Social Minimal Preview" title="Social Minimal Streaming Graphics" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo2.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Social Minimal</h4>
          </div>
          <div class="example-item">
            <div class="video-preview">
              <video muted loop playsinline preload="metadata" poster={`${import.meta.env.BASE_URL}logo-square.png`} aria-label="Dynamic Motion Graphics Preview" title="Dynamic Motion Graphics Example" class="lazy-video">
                <source src={`${import.meta.env.BASE_URL}multimedia/demo3.mp4`} type="video/mp4" />
              </video>
            </div>
            <h4>Dynamic Motion Graphics</h4>
          </div>
        </div>

        <div class="examples-cta">
          <a href={`${import.meta.env.BASE_URL}examples/`} class="btn-more-examples">
            View more examples & tutorials →
          </a>
        </div>
      </div>
    </section>

