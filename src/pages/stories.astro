---
import MainLayout from "../components/MainLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const stories = [
  {/* 
    author: "Alejandro M.",
    role: "Senior Video Editor",
    quote: "Ember changed the way I deliver my projects. I no longer have to wait for heavy renders from After Effects for a simple lower third. I just export to ProRes and that's it.",
    avatar: "AM"
  },
  {
    author: "Sofía R.",
    role: "Motion Designer",
    quote: "The precision of the alpha channel in the DVGE engine is impeccable. My overlays blend perfectly in DaVinci Resolve without edge artifacts.",
    avatar: "SR"
  },
  {
    author: "Marco T.",
    role: "Streamer & Producer",
    quote: "I use Ember for my live scoreboards. The 60fps stability is what convinced me to stop using unstable web tools.",
    avatar: "MT"
  },
  {*/
    author: "Elena V.",
    role: "Plugin Developer (fictional character for user story testing)",
    quote: "Lorem Ipsum Neque porro quisquam est qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit...",
    avatar: "EV"
  }
];
---

<MainLayout title="User Stories — Ember Motion Studio™">
  <Navigation />
  
  <main class="stories-page">
    <header class="page-header">
      <div class="container">
        <p class="label">Community</p>
        <h1 class="title">User Stories(Invented)</h1>
        <p class="subtitle">Discover how video and broadcast professionals are using Ember to optimize their productions.</p>
      </div>
    </header>

    <section class="stories-grid container">
      {stories.map(story => (
        <div class="story-card">
          <div class="quote-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H5c-1.25 0-2 .75-2 2v3c0 1.25.75 2 2 2h3c0 4-4 6-4 6z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-3c-1.25 0-2 .75-2 2v3c0 1.25.75 2 2 2h3c0 4-4 6-4 6z"></path></svg>
          </div>
          <p class="quote">"{story.quote}"</p>
          <div class="author-info">
            <div class="avatar">{story.avatar}</div>
            <div>
              <h4>{story.author}</h4>
              <p>{story.role}</p>
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class="join-community container">
      <div class="join-card">
        <h2>Share your story</h2>
        <p>Has Ember saved you time? Tell us your experience and help other creators discover the engine.</p>
        <a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-/discussions" class="btn-ghost">Join the Discussion</a>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  .stories-page {
    padding-top: 8rem;
    min-height: 100vh;
    background: radial-gradient(circle at top right, rgba(228, 76, 48, 0.03), transparent 400px);
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .page-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #E44C30;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
  }
  .title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: white;
    margin-bottom: 1.5rem;
  }
  .subtitle {
    font-size: 1.1rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2.5rem;
    margin-bottom: 8rem;
  }
  @media (max-width: 500px) {
    .stories-grid {
      grid-template-columns: 1fr;
    }
  }

  .story-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 2.5rem;
    border-radius: 20px;
    position: relative;
    transition: all 0.3s ease;
  }
  .story-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(228, 76, 48, 0.2);
    transform: translateY(-5px);
  }

  .quote-icon {
    color: #E44C30;
    opacity: 0.3;
    margin-bottom: 1.5rem;
  }
  .quote {
    font-size: 1.15rem;
    color: #ccc;
    line-height: 1.6;
    font-style: italic;
    margin-bottom: 2rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .avatar {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #E44C30, #801C0B);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: bold;
    font-size: 0.9rem;
    font-family: 'Outfit', sans-serif;
  }
  .author-info h4 {
    color: white;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    margin: 0;
  }
  .author-info p {
    color: #666;
    font-size: 0.8rem;
    margin: 0;
  }

  .join-community {
    margin-bottom: 8rem;
  }
  .join-card {
    text-align: center;
    padding: 4rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .join-card h2 {
    font-family: 'Outfit', sans-serif;
    color: white;
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .join-card p {
    color: #888;
    margin-bottom: 2rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-ghost {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid #E44C30;
    color: #E44C30;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    transition: all 0.2s ease;
  }
  .btn-ghost:hover {
    background: rgba(228, 76, 48, 0.05);
    transform: translateY(-2px);
  }
</style>
