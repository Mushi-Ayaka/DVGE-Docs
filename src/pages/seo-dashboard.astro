---
import MainLayout from '../components/MainLayout.astro';
import seoData from '../../docs/REPORTE_ESTRATEGICO_SEO.json';
import opportunities from '../../docs/OPORTUNIDADES_SEO_ESTRATEGICAS.json';

// Cálculos de Métricas
const totalVolume = seoData.reduce((acc, curr) => acc + curr.volume, 0);
const pendingVolume = opportunities.reduce((acc, curr) => acc + curr.volume, 0);
const totalKeywords = seoData.length;
const pendingCount = opportunities.length;

// Distribución por Vertical
const verticals = [...new Set(seoData.map(k => k.vertical))];
const verticalStats = verticals.map(v => ({
    name: v,
    count: seoData.filter(k => k.vertical === v).length,
    volume: seoData.filter(k => k.vertical === v).reduce((acc, curr) => acc + curr.volume, 0)
})).sort((a, b) => b.volume - a.volume);

---

<MainLayout title="SEO Intelligence Dashboard | Ember Motion Studio">
	<main class="seo-dashboard">
		<header class="dashboard-header">
			<div class="header-content">
				<h1>SEO Intelligence <span class="badge">PRO</span></h1>
				<p>Análisis estratégico de mercado y oportunidades de crecimiento orgánico.</p>
			</div>
			<div class="header-actions">
				<a href="/docs/REPORTE_ESTRATEGICO_SEO.xlsx" class="btn-download" download>
					Descargar Excel
				</a>
			</div>
		</header>

		<!-- KPI Cards -->
		<section class="kpi-grid">
			<div class="kpi-card">
				<span class="kpi-label">Volumen Total Mercado</span>
				<span class="kpi-value">{totalVolume.toLocaleString()}</span>
				<span class="kpi-trend">Búsquedas / mes</span>
			</div>
			<div class="kpi-card highlight">
				<span class="kpi-label">Oportunidades Pendientes</span>
				<span class="kpi-value">{pendingCount}</span>
				<span class="kpi-trend">Palabras clave detectadas</span>
			</div>
			<div class="kpi-card">
				<span class="kpi-label">Potencial de Tráfico</span>
				<span class="kpi-value">{pendingVolume.toLocaleString()}</span>
				<span class="kpi-trend">Vistas potenciales</span>
			</div>
			<div class="kpi-card">
				<span class="kpi-label">Keywords Totales</span>
				<span class="kpi-value">{totalKeywords}</span>
				<span class="kpi-trend">En base de datos</span>
			</div>
		</section>

		<div class="dashboard-content">
			<!-- Vertical Distribution -->
			<section class="section-card">
				<h2>Distribución por Verticales</h2>
				<div class="vertical-list">
					{verticalStats.map(stat => (
						<div class="vertical-item">
							<div class="vertical-info">
								<span class="v-name">{stat.name}</span>
								<span class="v-count">{stat.count} Keywords</span>
							</div>
							<div class="v-bar-container">
								<div class="v-bar" style={`width: ${(stat.volume / verticalStats[0].volume) * 100}%`}></div>
							</div>
							<span class="v-volume">{stat.volume.toLocaleString()} vol.</span>
						</div>
					))}
				</div>
			</section>

			<!-- Opportunities Table -->
			<section class="section-card wide">
				<div class="table-header">
					<h2>Oportunidades de Oro <span class="count-tag">{pendingCount}</span></h2>
					<p>Términos de alta relevancia con volumen real aún no explotados.</p>
				</div>
				<div class="table-container">
					<table>
						<thead>
							<tr>
								<th>Keyword</th>
								<th>Vertical</th>
								<th>Volumen</th>
								<th>Relevancia</th>
								<th>Longitud</th>
							</tr>
						</thead>
						<tbody>
							{opportunities.map(k => (
								<tr>
									<td class="keyword-cell">{k.keyword}</td>
									<td><span class={`v-tag ${k.vertical.toLowerCase().replace(' ', '-')}`}>{k.vertical}</span></td>
									<td class="volume-cell">{k.volume.toLocaleString()}</td>
									<td><span class="rel-tag">{k.relevance}</span></td>
									<td class="word-cell">{k.wordCount} palabras</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	</main>
</MainLayout>

<style>
	.seo-dashboard {
		padding: 2rem;
		max-width: 1400px;
		margin: 0 auto;
		color: #fff;
		font-family: 'Inter', sans-serif;
	}

	.dashboard-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
		border-bottom: 1px solid rgba(255,255,255,0.1);
		padding-bottom: 2rem;
	}

	h1 {
		font-family: 'Outfit', sans-serif;
		font-size: 2.5rem;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.badge {
		background: linear-gradient(135deg, #ff4d4d, #f9cb28);
		font-size: 0.9rem;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		color: #000;
		font-weight: 800;
	}

	.dashboard-header p {
		color: #888;
		margin-top: 0.5rem;
	}

	.btn-download {
		background: rgba(255,255,255,0.1);
		padding: 0.8rem 1.5rem;
		border-radius: 8px;
		color: #fff;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.2s;
		border: 1px solid rgba(255,255,255,0.2);
	}

	.btn-download:hover {
		background: #fff;
		color: #000;
	}

	/* KPI Grid */
	.kpi-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.kpi-card {
		background: rgba(255,255,255,0.03);
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid rgba(255,255,255,0.05);
		display: flex;
		flex-direction: column;
	}

	.kpi-card.highlight {
		background: linear-gradient(135deg, rgba(228, 76, 48, 0.1), rgba(249, 203, 40, 0.05));
		border-color: rgba(228, 76, 48, 0.3);
	}

	.kpi-label {
		color: #888;
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}

	.kpi-value {
		font-size: 2.2rem;
		font-weight: 800;
		font-family: 'Outfit', sans-serif;
	}

	.kpi-trend {
		font-size: 0.8rem;
		color: #555;
		margin-top: 0.5rem;
	}

	/* Layout Sections */
	.dashboard-content {
		display: grid;
		grid-template-columns: 350px 1fr;
		gap: 2rem;
	}

	.section-card {
		background: rgba(255,255,255,0.02);
		padding: 2rem;
		border-radius: 20px;
		border: 1px solid rgba(255,255,255,0.05);
	}

	.section-card.wide {
		grid-column: span 1;
	}

	h2 {
		font-family: 'Outfit', sans-serif;
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	/* Vertical List */
	.vertical-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.vertical-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.vertical-info {
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
	}

	.v-name { font-weight: 600; }
	.v-count { color: #666; }

	.v-bar-container {
		height: 8px;
		background: rgba(255,255,255,0.05);
		border-radius: 4px;
		overflow: hidden;
	}

	.v-bar {
		height: 100%;
		background: linear-gradient(90deg, #e44c30, #f9cb28);
		border-radius: 4px;
	}

	.v-volume {
		font-size: 0.8rem;
		color: #e44c30;
		text-align: right;
		font-weight: 700;
	}

	/* Table Styles */
	.table-container {
		overflow-x: auto;
		margin-top: 2rem;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
	}

	th {
		padding: 1rem;
		color: #555;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}

	td {
		padding: 1.2rem 1rem;
		border-bottom: 1px solid rgba(255,255,255,0.03);
		font-size: 0.95rem;
	}

	.keyword-cell {
		font-weight: 600;
		color: #fff;
	}

	.volume-cell {
		font-family: 'Outfit', sans-serif;
		font-weight: 700;
		color: #f9cb28;
	}

	.v-tag {
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 700;
		background: rgba(255,255,255,0.05);
	}

	.v-tag.streaming { color: #f9cb28; background: rgba(249, 203, 40, 0.1); }
	.v-tag.broadcast { color: #4facfe; background: rgba(79, 172, 254, 0.1); }
	.v-tag.motion-design { color: #fa709a; background: rgba(250, 112, 154, 0.1); }
	.v-tag.post-production { color: #00f2fe; background: rgba(0, 242, 254, 0.1); }
	.v-tag.technical { color: #98ec2d; background: rgba(152, 236, 45, 0.1); }

	.rel-tag {
		color: #4CAF50;
		font-weight: 700;
		font-size: 0.8rem;
	}

	.word-cell {
		color: #666;
		font-size: 0.85rem;
	}

	.count-tag {
		background: rgba(255,255,255,0.1);
		padding: 0.1rem 0.5rem;
		border-radius: 20px;
		font-size: 0.8rem;
		color: #888;
	}

	@media (max-width: 1000px) {
		.dashboard-content {
			grid-template-columns: 1fr;
		}
	}
</style>
