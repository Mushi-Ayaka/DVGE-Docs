---
const { currentLang, alternateLang, alternateUrl } = Astro.props;
---

<div id="language-notice" class="language-notice" style="display: none;">
  <div class="notice-content">
    <div class="notice-text">
      <p id="notice-msg-es" style="display: none;">¿Prefieres ver el sitio en español?</p>
      <p id="notice-msg-en" style="display: none;">Switch to English version?</p>
    </div>
    <div class="notice-actions">
      <a href={alternateUrl} class="btn-switch">
        {alternateLang === 'es' ? 'Cambiar a Español' : 'Switch to English'}
      </a>
      <button id="close-notice" class="btn-close" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ currentLang, alternateLang }}>
  const dismissKey = 'lang-notice-dismissed';
  const isDismissed = localStorage.getItem(dismissKey);

  if (!isDismissed) {
    const browserLang = navigator.language || navigator.userLanguage;
    const shouldShow = 
      (browserLang.startsWith('es') && currentLang === 'en') ||
      (browserLang.startsWith('en') && currentLang === 'es');

    if (shouldShow) {
      const notice = document.getElementById('language-notice');
      const msgEs = document.getElementById('notice-msg-es');
      const msgEn = document.getElementById('notice-msg-en');

      if (notice) {
        notice.style.display = 'block';
        if (browserLang.startsWith('es')) msgEs.style.display = 'block';
        else msgEn.style.display = 'block';
      }

      document.getElementById('close-notice')?.addEventListener('click', () => {
        notice.style.display = 'none';
        localStorage.setItem(dismissKey, 'true');
      });
    }
  }
</script>

<style>
  .language-notice {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2000;
    width: calc(100% - 2rem);
    max-width: 500px;
    background: rgba(13, 13, 13, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    padding: 1rem 1.25rem;
    animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .notice-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .notice-text p {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: white;
  }

  .notice-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-switch {
    background: #E44C30;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s;
  }

  .btn-switch:hover {
    transform: translateY(-1px);
    background: #F05A3E;
  }

  .btn-close {
    background: transparent;
    border: none;
    color: #888;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .btn-close:hover {
    color: white;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translate(-50%, 20px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 480px) {
    .notice-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .notice-actions {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
