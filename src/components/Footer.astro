---
import { getLangFromUrl } from '../i18n/utils';
const base = import.meta.env.BASE_URL;
const downloadUrl = "https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-/releases/download/v5.9.0/EmberMotionStudio-Setup-5.9.0.exe";
const currentLang = getLangFromUrl(Astro.url);
const prefix = currentLang === 'en' ? '' : 'es/';
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-info">
      <p class="footer-tagline">
        {currentLang === 'en' 
          ? 'MIT Licensed broadcast graphics engine. ProRes 4444 with alpha channel, zero configuration.' 
          : 'Motor de gráficos de broadcast licenciado bajo MIT. ProRes 4444 con canal alfa, sin configuración.'}
      </p>
      <div class="footer-actions">
        <a href={downloadUrl} class="footer-cta">{currentLang === 'en' ? 'Download v5.9.0' : 'Descargar v5.9.0'}</a>
      </div>
      <div class="social-links">
        <a href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-" target="_blank" rel="noopener" aria-label="GitHub - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="https://www.instagram.com/ember_motion_studio/" target="_blank" rel="noopener" aria-label="Instagram - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://www.youtube.com/@embermotionstudio" target="_blank" rel="noopener" aria-label="YouTube - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
        <a href="https://www.facebook.com/EmberMotionStudio" target="_blank" rel="noopener" aria-label="Facebook - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://www.threads.net/@ember_motion_studio" target="_blank" rel="noopener" aria-label="Threads - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg>
        </a>
        <a href="https://www.tiktok.com/@embermotionstudio" target="_blank" rel="noopener" aria-label="TikTok - Ember Motion Studio">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
        </a>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=barojonatan8@gmail.com" target="_blank" rel="noopener" aria-label="Contacto por email">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-nav">
      <div class="nav-column">
        <h4>{currentLang === 'en' ? 'Engine' : 'Motor'}</h4>
        <a href={`${base}${prefix}engine/architecture/`}>{currentLang === 'en' ? 'Core Architecture' : 'Arquitectura Central'}</a>
        <a href={`${base}${prefix}engine/performance/`}>{currentLang === 'en' ? 'Performance' : 'Rendimiento'}</a>
        <a href={`${base}${prefix}engine/benchmarks/`}>Benchmarks</a>
        <a href={`${base}${prefix}engine/roadmap/`}>{currentLang === 'en' ? 'Roadmap' : 'Hoja de Ruta'}</a>
      </div>
      <div class="nav-column">
        <h4>{currentLang === 'en' ? 'Ecosystem' : 'Ecosistema'}</h4>
        <a href={`${base}${prefix}ecosystem/community/`}>{currentLang === 'en' ? 'Community' : 'Comunidad'}</a>
        <a href={`${base}${prefix}ecosystem/repository/`}>{currentLang === 'en' ? 'Plugin Gallery' : 'Galería de Plugins'}</a>
        <a href={`${base}${prefix}ecosystem/api/`}>{currentLang === 'en' ? 'Extension API' : 'API de Extensión'}</a>
        <a href={`${base}${prefix}development/quick-start/`}>{currentLang === 'en' ? 'Quick Start' : 'Guía de Inicio'}</a>
        <a href={`${base}${prefix}development/contributing/`}>{currentLang === 'en' ? 'Contributing' : 'Contribuir'}</a>
      </div>
      <div class="nav-column">
        <h4>{currentLang === 'en' ? 'Project' : 'Proyecto'}</h4>
        <a href={`${base}${prefix}about/user-manual/`}>{currentLang === 'en' ? 'User Manual' : 'Manual de Usuario'}</a>
        <a href={`${base}${prefix}about/changelog/`}>Changelog</a>
        <a href={`${base}${prefix}about/vision/`}>{currentLang === 'en' ? 'Vision' : 'La Visión'}</a>
        <a href={`${base}${prefix}about/me/`}>Jonatan Barón</a>
        <a href={`${base}${prefix}about/credits/`}>{currentLang === 'en' ? 'Credits' : 'Créditos'}</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-version">
      <p>&copy; 2026 Jonatan Barón. {currentLang === 'en' ? 'All rights reserved.' : 'Todos los derechos reservados.'}</p>
      <p class="footer-legal">
        <a href={`${base}${prefix}about/license/`}>{currentLang === 'en' ? 'MIT License' : 'Licencia MIT'}</a>
        &nbsp;·&nbsp;
        <a href={`${base}${prefix}about/privacy/`}>{currentLang === 'en' ? 'Privacy' : 'Privacidad'}</a>
        &nbsp;·&nbsp;
        <a href={`${base}${prefix}about/terms/`}>{currentLang === 'en' ? 'Terms' : 'Términos'}</a>
      </p>
      <!-- EEAT: Autoría y versión — señal de confianza para Google -->
      <p class="footer-eeat">
        Developed by <strong>Jonatan Barón</strong> — Ember Motion Studio powered by DVGE
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--glass-border);
    background: var(--color-surface);
    padding: 5rem 2rem 2rem;
    margin-top: 4rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .footer-tagline {
    color: var(--color-text-muted);
    max-width: 280px;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-actions {
    margin-bottom: 1.5rem;
  }

  .footer-cta {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .footer-cta:hover {
    background: var(--color-primary-hover, #f05a3e);
  }

  .social-links {
    display: flex;
    gap: 1.25rem;
  }

  .social-links a {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .social-links a:hover { color: var(--color-primary); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .nav-column h4 {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
  }

  .nav-column a {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-column a:hover { color: var(--color-primary); }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .footer-version {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-version p { margin: 0; }

  .footer-eeat {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 0.5rem;
  }
  .footer-eeat strong {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .version-badge {
    background: rgba(228, 76, 48, 0.1);
    color: #E44C30;
    padding: 2px 10px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    border: 1px solid rgba(228, 76, 48, 0.2);
    display: inline-block;
  }

  .footer-legal a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.2s ease;
  }
  .footer-legal a:hover { color: var(--color-primary); }

  @media (max-width: 968px) {
    .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-info {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .footer-tagline { max-width: 100%; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }
</style>
