---
import { getLangFromUrl } from '../i18n/utils';
import IconCpu from './icons/IconCpu.astro';
import IconShield from './icons/IconShield.astro';
import IconZap from './icons/IconZap.astro';

const currentLang = getLangFromUrl(Astro.url);
const prefix = currentLang === 'en' ? '' : 'es/';
const base = import.meta.env.BASE_URL;

const pillars = currentLang === 'en' ? [
  {
    title: "Vibe Motion Workflow",
    description: "Describe the animation in plain text -> AI generates the code -> Paste into Ember -> Customize visual parameters instantly in the Inspector -> Export to broadcast-grade .mov with alpha channel.",
    color: "#E44C30",
    icon: IconZap,
    featured: true
  },
  {
    title: "ProRes 4444 + Alpha",
    description: "Pure alpha channel from frame 0. Seamlessly compatible with DaVinci Resolve, Premiere Pro, and After Effects with zero configuration.",
    color: "#ffffff",
    icon: IconZap,
    featured: false
  },
  {
    title: "Zero Dependencies",
    description: "Chromium and FFmpeg are automatically downloaded on the first run. Zero environment setup required.",
    color: "#ffffff",
    icon: IconCpu,
    featured: false
  },
  {
    title: "Security Sandbox",
    description: "Shadow DOM + proxy fakeWindow. No third-party plugins can access the host system.",
    color: "#ffffff",
    icon: IconShield,
    featured: false
  }
] : [
  {
    title: "Flujo Vibe Motion",
    description: "Describe la animación con texto -> La IA genera el código -> Pégalo en Ember -> Personaliza los parámetros visuales al instante desde el Inspector -> Exporta a .mov profesional con canal alfa.",
    color: "#E44C30",
    icon: IconZap,
    featured: true
  },
  {
    title: "ProRes 4444 + Alpha",
    description: "Canal alfa puro desde el fotograma 0. Compatible con DaVinci Resolve, Premiere Pro y After Effects sin configuración adicional.",
    color: "#ffffff",
    icon: IconZap,
    featured: false
  },
  {
    title: "Sin Dependencias Previas",
    description: "Chromium y FFmpeg se descargan automáticamente en el primer inicio. Cero configuración del entorno.",
    color: "#ffffff",
    icon: IconCpu,
    featured: false
  },
  {
    title: "Sandbox de Seguridad",
    description: "Shadow DOM + proxy fakeWindow. Ningún plugin de terceros accede al sistema host.",
    color: "#ffffff",
    icon: IconShield,
    featured: false
  }
];
---

<section class="pillars-section">

  <div class="section-header">
    <p class="section-label">{currentLang === 'en' ? 'Architecture' : 'Arquitectura'}</p>
    <div class="section-header-flex">
      <h2 class="section-title">
        {currentLang === 'en' ? 'Built for' : 'Construido para'}
        <br /><em>{currentLang === 'en' ? 'real production' : 'producción real'}</em>
      </h2>
      <a href={`${base}${prefix}engine/architecture/`} class="section-link">
        {currentLang === 'en' ? 'View full architecture →' : 'Ver arquitectura completa →'}
      </a>
    </div>
  </div>

  <div class="pillars-layout">

    <div class="pillar-featured">
      <div class="pillar-featured-inner">
        <div class="pillar-number" aria-hidden="true">01</div>
        <h3>{pillars[0].title}</h3>
        <p>{pillars[0].description}</p>
        <div class="pillar-featured-rule" aria-hidden="true" />
        <a href={`${base}${prefix}development/ai-guide/`} class="pillar-link">
          {currentLang === 'en' ? 'View AI guide →' : 'Ver guía de IA →'}
        </a>
      </div>
    </div>

    <div class="pillars-secondary">
      {pillars.slice(1).map((pillar, i) => (
        <div class="pillar-card">
          <span class="pillar-number" aria-hidden="true">0{i + 2}</span>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
          {(pillar.title === "Sandbox de Seguridad" || pillar.title === "Security Sandbox") && (
            <a href={`${base}${prefix}engine/architecture/#sandbox-de-seguridad-y-aislamiento`} class="pillar-card-link">
              {currentLang === 'en' ? 'Technical details →' : 'Detalles técnicos →'}
            </a>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .pillars-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 1.5rem 6rem;
  }

  @media (min-width: 768px) {
    .pillars-section {
      padding: 8rem 4rem 8rem;
    }
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .section-label {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: #E44C30;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem 0;
  }

  .section-title {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
  }

  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: #E44C30;
    text-decoration: none;
    letter-spacing: 0.02em;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(228, 76, 48, 0.3);
    transition: all 0.2s;
  }
  .section-link:hover {
    border-bottom-color: #E44C30;
    opacity: 0.8;
  }

  .section-title em {
    font-style: normal;
    color: #444;
    -webkit-text-stroke: 0;
  }

  .pillars-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .pillars-layout {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  .pillar-featured {
    border: 1px solid rgba(228, 76, 48, 0.25);
    border-radius: 4px;
    background: rgba(228, 76, 48, 0.04);
    position: relative;
    overflow: hidden;
  }

  .pillar-featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, #E44C30, transparent);
  }

  .pillar-featured-inner {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 280px;
  }

  @media (min-width: 768px) {
    .pillar-featured-inner {
      padding: 3rem;
      min-height: 360px;
    }
  }

  .pillar-featured h3 {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .pillar-featured p {
    font-size: 0.95rem;
    color: #888;
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }

  .pillar-featured-rule {
    width: 40px;
    height: 1px;
    background: rgba(228, 76, 48, 0.4);
  }

  .pillar-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: #E44C30;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .pillar-link:hover { opacity: 0.7; }

  /* Número de card */
  .pillar-number {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.65rem;
    color: #333;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  /* Cards secundarias */
  .pillars-secondary {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pillar-card {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 1.75rem;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .pillar-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
  }

  .pillar-card h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #e0e0e0;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .pillar-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    margin: 0 0 1rem 0;
  }

  .pillar-card-link {
    font-size: 0.75rem;
    font-weight: 600;
    color: #E44C30;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
  }
  .pillar-card-link:hover { opacity: 0.7; }

  @media (max-width: 767px) {
    .pillar-featured-inner {
      min-height: auto;
    }
    .section-title {
      font-size: 2rem;
    }
  }
</style>
