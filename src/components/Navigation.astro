---
import { getLangFromUrl, getAlternateUrl, getAlternateLang } from '../i18n/utils';
const base = import.meta.env.BASE_URL;
const downloadUrl =
  "https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-/releases/download/v5.8.0/EmberMotionStudio-Setup-5.8.0.exe";
const currentLang = getLangFromUrl(Astro.url);
const alternateLang = getAlternateLang(currentLang);
const alternateUrl = getAlternateUrl(Astro.url, alternateLang);
const prefix = currentLang === 'en' ? '' : 'es/';
---

<nav class="nav-container">
  <div class="nav-content">
    <a href={base} class="logo" id="navLogo">
      <svg
        class="ember-mark"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
      >
        <defs>
          <linearGradient id="navEmberGrad" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#801C0B"></stop>
            <stop offset="50%" stop-color="#E44C30"></stop>
            <stop offset="100%" stop-color="#FFAB99"></stop>
          </linearGradient>
        </defs>
        <polygon
          class="mark-trail t1"
          points="20,40 30,50 20,60 10,50"
          stroke="#801C0B"
          stroke-width="2.5"
          opacity="0.3"
          fill="none"></polygon>
        <polygon
          class="mark-trail t2"
          points="45,36 59,50 45,64 31,50"
          stroke="#E44C30"
          stroke-width="4"
          opacity="0.6"
          fill="none"></polygon>
        <polygon
          class="mark-core"
          points="75,30 95,50 75,70 55,50"
          fill="url(#navEmberGrad)"></polygon>
      </svg>
      <span>Ember</span>
    </a>

    <button
      class="mobile-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path class="menu-icon" d="M3 12h18M3 6h18M3 18h18"></path>
        <path class="close-icon" d="M18 6L6 18M6 6l12 12" style="display: none;"
        ></path>
      </svg>
    </button>

    <div class="nav-links" id="nav-links">
      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          {currentLang === 'en' ? 'Engine' : 'Motor'}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}${prefix}engine/architecture/`} role="menuitem">
            {currentLang === 'en' ? 'Core Architecture' : 'Arquitectura Central'}
          </a>
          <a href={`${base}${prefix}engine/performance/`} role="menuitem">{currentLang === 'en' ? 'Performance' : 'Rendimiento'}</a>
          <a href={`${base}${prefix}engine/benchmarks/`} role="menuitem">Benchmarks</a>
          <a href={`${base}${prefix}engine/roadmap/`} role="menuitem">{currentLang === 'en' ? 'Roadmap' : 'Hoja de Ruta'}</a>
        </div>
      </div>

      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          {currentLang === 'en' ? 'Ecosystem' : 'Ecosistema'}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}${prefix}ecosystem/community/`} role="menuitem">{currentLang === 'en' ? 'Community' : 'Comunidad'}</a>
          <a href={`${base}${prefix}ecosystem/repository/`} role="menuitem">
            {currentLang === 'en' ? 'Plugin Gallery' : 'Galería de Plugins'}
          </a>
          <a href={`${base}${prefix}ecosystem/api/`} role="menuitem">{currentLang === 'en' ? 'Extension API' : 'API de Extensión'}</a>
        </div>
      </div>

      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          {currentLang === 'en' ? 'Development' : 'Desarrollo'}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}${prefix}development/quick-start/`} role="menuitem">
            {currentLang === 'en' ? 'Quick Start' : 'Guía de Inicio'}
          </a>
          <a href={currentLang === 'en' ? `${base}examples/` : `${base}es/ejemplos/`} role="menuitem">{currentLang === 'en' ? 'Examples & Tutorials' : 'Ejemplos y Tutoriales'}</a>
          <a href={`${base}${prefix}development/ai-guide/`} role="menuitem">
            {currentLang === 'en' ? 'AI Plugins' : 'Plugins con IA'}
          </a>
          <a href={`${base}${prefix}development/contributing/`} role="menuitem">
            {currentLang === 'en' ? 'Contributing' : 'Contribuir'}
          </a>
        </div>
      </div>

      <!-- 
      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          Comunidad
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}evidencias/`} role="menuitem"
            >Evidencias de Trabajo</a
          >
          <a href={`${base}historias/`} role="menuitem">Historias de Usuarios</a>
        </div>
      </div>
      -->

      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          {currentLang === 'en' ? 'Project' : 'Proyecto'}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}${prefix}about/user-manual/`} role="menuitem">
            {currentLang === 'en' ? 'User Manual' : 'Manual de Usuario'}
          </a>
          <a href={`${base}${prefix}about/changelog/`} role="menuitem">Changelog</a>
          <a href={`${base}${prefix}about/vision/`} role="menuitem">{currentLang === 'en' ? 'Vision' : 'La Visión'}</a>
          <a href={`${base}${prefix}about/transparency/`} role="menuitem">
            {currentLang === 'en' ? 'Transparency' : 'Transparencia'}
          </a>
          <a href={`${base}${prefix}about/branding/`} role="menuitem">{currentLang === 'en' ? 'Brand Identity' : 'Identidad Visual'}</a>
        </div>
      </div>

      <div class="dropdown">
        <button class="dropbtn" aria-expanded="false" aria-haspopup="true">
          {currentLang === 'en' ? 'About' : 'Acerca de'}
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div class="dropdown-content" role="menu">
          <a href={`${base}${prefix}about/me/`} role="menuitem">{currentLang === 'en' ? 'The Developer' : 'El Desarrollador'}</a>
          <a href={`${base}${prefix}about/credits/`} role="menuitem">{currentLang === 'en' ? 'Credits' : 'Créditos'}</a>
          <a href={`${base}${prefix}about/license/`} role="menuitem">{currentLang === 'en' ? 'License' : 'Licencia'}</a>
        </div>
      </div>

      <a
        href="https://github.com/Mushi-Ayaka/Dynamic-Vector-Graphics-Engine--DVGE-"
        target="_blank"
        rel="noopener"
        class="github-link"
        aria-label="Repositorio en GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      <!-- Language Switcher -->
      <a
        href={alternateUrl}
        class="lang-switch"
        aria-label={alternateLang === 'en' ? 'Switch to English' : 'Cambiar a Español'}
        title={alternateLang === 'en' ? 'Switch to English' : 'Cambiar a Español'}
      >
        {alternateLang.toUpperCase()}
      </a>

      <a
        href={downloadUrl}
        class="nav-cta"
        aria-label="Descargar Ember Motion Studio v5.8.0"
      >
        {currentLang === 'en' ? 'Download' : 'Descargar'}
      </a>
    </div>
  </div>
</nav>

<script>
  // Mobile toggle
  const toggle = document.querySelector(".mobile-toggle") as HTMLButtonElement;
  const navLinks = document.querySelector(".nav-links");
  const menuIcon = document.querySelector(".menu-icon") as HTMLElement;
  const closeIcon = document.querySelector(".close-icon") as HTMLElement;

  toggle?.addEventListener("click", () => {
    const isActive = navLinks?.classList.toggle("active");
    toggle.setAttribute("aria-expanded", String(isActive));
    toggle.setAttribute("aria-label", isActive ? "Cerrar menú" : "Abrir menú");
    if (menuIcon && closeIcon) {
      menuIcon.style.display = isActive ? "none" : "block";
      closeIcon.style.display = isActive ? "block" : "none";
    }
  });

  // Dropdowns: hover en desktop, click en móvil/touch
  document.querySelectorAll(".dropdown").forEach((dropdown) => {
    const btn = dropdown.querySelector(".dropbtn") as HTMLButtonElement;
    const content = dropdown.querySelector(".dropdown-content") as HTMLElement;

    btn?.addEventListener("click", (e) => {
      // Solo activar click en móvil (cuando el toggle es visible)
      if (window.innerWidth <= 960) {
        e.preventDefault();
        const isOpen =
          content.style.maxHeight && content.style.maxHeight !== "0px";
        // Cerrar todos los demás
        document.querySelectorAll(".dropdown-content").forEach((el) => {
          (el as HTMLElement).style.maxHeight = "0px";
        });
        document.querySelectorAll(".dropbtn").forEach((b) => {
          (b as HTMLButtonElement).setAttribute("aria-expanded", "false");
        });
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          btn.setAttribute("aria-expanded", "true");
        }
      }
    });

    // Keyboard: Enter/Space abre el dropdown
    btn?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        btn.click();
      }
      if (e.key === "Escape") {
        content.style.maxHeight = "0px";
        btn.setAttribute("aria-expanded", "false");
        btn.focus();
      }
    });
  });

  // Parallax 3D sutil para el logo con throttling para rendimiento
  const navLogo = document.getElementById("navLogo");
  if (navLogo) {
    const MAX_ROTATION = 15;
    let ticking = false;

    document.addEventListener("mousemove", (e) => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const x = (e.clientX / window.innerWidth) * 2 - 1;
          const y = (e.clientY / window.innerHeight) * 2 - 1;
          const rotateX = y * -MAX_ROTATION;
          const rotateY = x * MAX_ROTATION;
          navLogo.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          ticking = false;
        });
        ticking = true;
      }
    });

    document.addEventListener("mouseleave", () => {
      navLogo.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
    });
  }

  // Cerrar menú móvil al hacer click fuera
  document.addEventListener("click", (e) => {
    if (
      !toggle?.contains(e.target as Node) &&
      !navLinks?.contains(e.target as Node)
    ) {
      navLinks?.classList.remove("active");
      toggle?.setAttribute("aria-expanded", "false");
      if (menuIcon && closeIcon) {
        menuIcon.style.display = "block";
        closeIcon.style.display = "none";
      }
    }
  });
</script>

<style>
  .nav-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0.75rem 1.5rem;
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
    background: rgba(5, 5, 5, 0.8);
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: "Outfit", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text);
    text-decoration: none;
    z-index: 1001;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ember-mark {
    filter: drop-shadow(0 0 10px rgba(228, 76, 48, 0.3));
    animation: floatGlow 6s infinite alternate ease-in-out;
  }

  .mark-core {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: 75px 50px;
  }

  .mark-trail {
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }

  .logo:hover .mark-core {
    transform: translateX(6px) scale(1.05);
  }

  .logo:hover .mark-trail.t2 {
    transform: translateX(-4px);
    opacity: 0.9;
  }

  .logo:hover .mark-trail.t1 {
    transform: translateX(-10px);
    opacity: 0.6;
  }

  @keyframes floatGlow {
    0% {
      filter: drop-shadow(0 0 8px rgba(228, 76, 48, 0.2));
      transform: translateY(0px);
    }
    100% {
      filter: drop-shadow(0 0 20px rgba(228, 76, 48, 0.5));
      transform: translateY(-2px);
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }
  .mobile-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    border-radius: 4px;
  }

  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropbtn {
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 500;
    font-family: "Inter", sans-serif;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    transition: color 0.2s ease;
  }
  .dropbtn:focus-visible {
    outline: 2px solid var(--color-primary);
    border-radius: 4px;
  }

  .dropdown:hover .dropbtn,
  .dropbtn[aria-expanded="true"] {
    color: var(--color-primary);
  }

  .dropdown-content {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 8px; /* espacio visual sin romper el hover */
    background-color: #0d0d0d;
    min-width: 200px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.8);
    z-index: 101;
    overflow: hidden;
  }

  /* Cubre el gap entre botón y panel para que el hover no se interrumpa */
  .dropdown::before {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 8px;
    z-index: 100;
  }

  .dropdown-content a {
    color: var(--color-text-muted);
    padding: 10px 20px;
    text-decoration: none;
    display: block;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .dropdown-content a:hover,
  .dropdown-content a:focus-visible {
    background-color: rgba(228, 76, 48, 0.1);
    color: var(--color-primary);
    padding-left: 25px;
    outline: none;
  }

  .dropdown:hover .dropdown-content {
    display: block;
    animation: fadeIn 0.15s ease;
  }

  .github-link {
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .github-link:hover {
    color: var(--color-primary);
  }
  .github-link:focus-visible {
    outline: 2px solid var(--color-primary);
    border-radius: 4px;
  }

  .nav-cta {
    background: var(--color-primary);
    color: white;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--color-primary-hover, #f05a3e);
    transform: translateY(-1px);
  }
  .nav-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translate(-50%, -6px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .lang-switch {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }
  .lang-switch:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 960px) {
    .mobile-toggle {
      display: block;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 80%;
      max-width: 350px;
      height: 100vh;
      background: #050505;
      flex-direction: column;
      align-items: flex-start;
      padding: 6rem 2rem 2rem;
      transition: right 0.3s ease-in-out;
      border-left: 1px solid var(--glass-border);
      gap: 0;
      overflow-y: auto;
    }
    .nav-links.active {
      right: 0;
    }

    .dropdown {
      width: 100%;
    }

    .dropbtn {
      width: 100%;
      justify-content: space-between;
      font-size: 1.1rem;
      padding: 1rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .dropdown-content {
      position: static;
      transform: none;
      display: block;
      background: transparent;
      border: none;
      box-shadow: none;
      padding-left: 1rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
      animation: none;
    }

    .dropdown:hover .dropdown-content {
      /* En móvil el hover no aplica — se maneja por JS */
      display: block;
      max-height: 0;
    }

    .dropdown-content a {
      padding: 0.75rem 0;
    }

    .github-link {
      margin-top: 1rem;
    }

    .nav-cta {
      margin-top: 1.5rem;
      width: 100%;
      text-align: center;
      padding: 0.75rem;
    }
  }
</style>
